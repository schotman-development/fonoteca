root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.cs]
# Prefer file-scoped namespaces; the extra nesting level buys nothing.
csharp_style_namespace_declarations = file_scoped:error

csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# `when_multiline`, not `true`: single-line guard clauses (`if (x is null) return -1;`)
# are the clearest way to write a comparison's preamble, and forcing braces onto
# them adds four lines of noise per guard.
csharp_prefer_braces = when_multiline:warning
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

dotnet_style_readonly_field = true:warning
# Interface members are implicitly public; spelling it out is noise, and C#
# only started allowing it at all in 8.0.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# Awaiting without ConfigureAwait is a real hazard in library code.
dotnet_diagnostic.CA2007.severity = warning

#-----------------------------------------------------------------------------
# EF Core migrations are generated by `dotnet ef` and must not be hand-edited —
# editing one changes what has already been applied to real databases. Marking
# the folder as generated stops style and performance analyzers from failing a
# build over code no human is allowed to fix.
#-----------------------------------------------------------------------------
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
