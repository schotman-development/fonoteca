{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Fonoteca": "Host=localhost;Port=5432;Database=fonoteca;Username=fonoteca;Password=fonoteca"
  },
  "Fonoteca": {
    "LibraryPath": "/mnt/music",
    "AllowFileMutation": false,
    "FpcalcPath": "fpcalc",
    "FfprobePath": "ffprobe",
    "FfmpegPath": "ffmpeg",
    "ScanConcurrency": 4,
    "MusicBrainzContact": "",
    "MusicBrainzServer": "https://musicbrainz.org",
    "MusicBrainzRequestIntervalMs": 1000,
    "AcoustIdApiKey": "",
    "AcoustIdMinimumScore": 0.90,
    "AcoustIdMinimumMargin": 0.05,
    "IdentifyAfterScan": true,
    "WarmCandidates": true,
    "CorsOrigins": ["http://localhost:5173"]
  }
}
