<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure unit tests. No database, no filesystem, no network, no fixtures.
    If a test here needs any of those, the rule under test belongs on the wrong
    side of the domain boundary.
  -->

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Fonoteca.Domain/Fonoteca.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
