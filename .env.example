# Fonoteca — environment template
#
# Copy to `.env` and edit. `.env` is gitignored; so is every other `.env.*`
# except this file.
#
#   cp .env.example .env
#
# WHO READS THIS FILE
#
#   compose.yaml   automatically, for ${VAR} substitution
#   scripts/dev.sh exports it so the API inherits it
#
# The API is ASP.NET Core, which maps environment variables onto its
# configuration tree using a DOUBLE UNDERSCORE as the separator. So
# `Fonoteca__LibraryPath` here overrides `Fonoteca:LibraryPath` in
# appsettings.json. That is why the names below look the way they do.
#
# Anything marked RESERVED is not read by any code yet. It is here so the name
# is settled before the feature lands, not because setting it does something.
#
# QUOTE ANY VALUE CONTAINING `;`, a space, `#` or `$`.
#
# Two different parsers read this file. Compose has its own and copes with bare
# values; scripts/dev.sh sources it with `set -a` so that bash exports it, and
# bash treats `;` as a command separator. An unquoted connection string
# therefore silently loses everything after the first semicolon — including the
# password — and the failure surfaces as an authentication error from Postgres,
# a long way from the cause. Quotes satisfy both parsers.


# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Read by compose.yaml to provision the container, and by the connection string
# below. Change the password before exposing this beyond localhost.

POSTGRES_DB=fonoteca
POSTGRES_USER=fonoteca
POSTGRES_PASSWORD=fonoteca
POSTGRES_PORT=5432

# Must agree with the four values above. Kept explicit rather than assembled
# from them, because the API also has to work against a database this compose
# file did not create.
ConnectionStrings__Fonoteca="Host=localhost;Port=5432;Database=fonoteca;Username=fonoteca;Password=fonoteca"


# ---------------------------------------------------------------------------
# Library
# ---------------------------------------------------------------------------

# Absolute path to the music library root, as the API process sees it.
Fonoteca__LibraryPath=/mnt/music

# Whether the app may MODIFY files in the library.
#
# The verified write path now exists — read with two libraries, stage to a
# temporary sibling, read back with both, atomic swap, undo journal — and the
# identification pass is the one thing that uses it, to write an ACOUSTID_ID tag.
# See docs/adr/0002-two-tag-libraries.md.
#
# It still defaults to false, and leaving it there costs you nothing. With it off
# the pass fingerprints, looks up and records everything; it just does not write.
# Turning it on and running again then writes the tags without spending a single
# further AcoustID request, so the safe default is a preview rather than a wasted
# hour.
#
# Take a backup before the first real write.
Fonoteca__AllowFileMutation=false

# How many files to hash and fingerprint at once. Each one spawns an ffprobe or
# fpcalc process, so this is roughly a process-count budget; past core count it
# buys nothing and starves the API.
#
# Raising it above about 2 buys nothing for identification either, whatever the
# core count: fingerprinting takes ~190ms per file and AcoustID's rate limit lets
# one lookup through every 340ms, so the gate is already the bottleneck several
# times over. The default is 4 for slow storage, not for throughput.
Fonoteca__ScanConcurrency=4

# How well a fingerprint must match before its AcoustID is written into a file.
#
# The winning cluster must clear this AND beat the runner-up by a margin — two
# clusters at 0.95 and 0.94 are AcoustID reporting two candidates and no opinion,
# usually a track that appears on both an album and a compilation. Those are
# recorded as ambiguous and left alone.
#
# Lowering it does not only tag more files, it tags more files wrongly, and a
# wrong identifier is believed by every later pass and by every other tool that
# reads the file.
Fonoteca__AcoustIdMinimumScore=0.90

# How far clear of the runner-up the winning cluster has to be.
#
# 0.05 is conservative and measured evidence says it is on the strict side:
# against a real 7,962-file library it left about one file in eight
# unidentified, and the cases it caught looked like 0.9894 against 0.9506 —
# an established cluster beside a poorly-merged duplicate of itself, rather
# than a track beside its remaster.
#
# Lowering this to ~0.02 identifies those. It also narrows the gap that keeps
# an album version from being tagged as its single. Which risk matters more
# depends on the library.
Fonoteca__AcoustIdMinimumMargin=0.05

# Whether finishing a scan starts an identification pass.
#
# On by default: the scan says which files exist, identification says what they
# are. It converges — once the library is identified, later scans find nothing to
# do. Turn it off to keep the two entirely separate.
Fonoteca__IdentifyAfterScan=true


# ---------------------------------------------------------------------------
# External binaries
# ---------------------------------------------------------------------------
# Bare names resolve through PATH, which works when env.sh has been sourced.
# Set absolute paths for a long-running service: a process started from a
# desktop session that predates the toolchain keeps the PATH it was born with,
# and will not find these however correct `which` looks at your prompt.

Fonoteca__FfmpegPath=ffmpeg
Fonoteca__FfprobePath=ffprobe
Fonoteca__FpcalcPath=fpcalc


# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Origins allowed to call the API. Same-origin in production; in development the
# Vite dev server and Storybook are separate origins and must be listed.
Fonoteca__CorsOrigins__0=http://localhost:5173
Fonoteca__CorsOrigins__1=http://localhost:6006


# ---------------------------------------------------------------------------
# MusicBrainz
# ---------------------------------------------------------------------------

# REQUIRED before any MusicBrainz call. They enforce roughly one request per
# second and require a User-Agent that identifies the application and gives them
# a way to contact you. Sending a generic agent gets the IP blocked, so this is
# configuration rather than a constant.
#
#   Fonoteca/0.1 ( you@example.com )
Fonoteca__MusicBrainzContact=

# Which server to ask. The public instance by default.
#
# A local mirror is the supported — and only — way past one request per second.
# See docs/musicbrainz-mirror.md; `./scripts/musicbrainz-mirror.sh setup` builds
# one. With a mirror, both lines below change together:
#
#   Fonoteca__MusicBrainzServer=http://localhost:5000
#   Fonoteca__MusicBrainzRequestIntervalMs=0
#
# An interval under 1000 against musicbrainz.org itself is refused at startup,
# because the unsupported way past the limit ends in a blocked address.
Fonoteca__MusicBrainzServer=https://musicbrainz.org
Fonoteca__MusicBrainzRequestIntervalMs=1000


# ---------------------------------------------------------------------------
# AcoustID
# ---------------------------------------------------------------------------
# Free application key for non-commercial use, from
# https://acoustid.org/new-application
#
# Without it the app still starts and logs one line; lookups are then refused
# locally, naming this setting, rather than being sent unidentified.
#
# The name matters and is easy to get wrong. FonotecaOptions is flat, so this
# binds `Fonoteca:AcoustIdApiKey` — NOT `Fonoteca__Providers__AcoustId__ApiKey`,
# which is what this file said until identification was wired up and the key
# turned out never to have reached the application.
Fonoteca__AcoustIdApiKey=

# The operator's own *user* key, and a different thing from the one above: that
# says which application is calling, this says who is making the claim. It is
# needed only to submit fingerprints back — the button on an album page for
# files a person filed by hand and AcoustID has never heard — and nothing in
# Fonoteca ever submits anything without that click. Leave it empty and the rest
# works; the submit is then refused locally, naming this setting.
#
# From https://acoustid.org/ once signed in. AcoustID asks that applications not
# ship one of their own, which for a self-hosted manager is satisfied by it
# being here.
Fonoteca__AcoustIdUserKey=


# ---------------------------------------------------------------------------
# Qobuz
# ---------------------------------------------------------------------------
# Your own subscription. Reverse-engineered API with no published contract — it
# will change without warning, which is why every value here is configuration
# and none of it is a constant: when they rotate, the fix is this file.
#
# ACQUISITION IS MANUAL. Nothing polls, monitors or upgrades. Every download is
# a person who searched, read a track list and pressed a button — the same
# standard the AcoustID submission path holds itself to, and for a stronger
# reason: this one spends a subscription. The failure mode of automating a
# reverse-engineered API on a paid personal account is the account, not a retry.
#
# All three values come out of a signed-in web player session. There is no login
# call in the application on purpose: a password in the process is a password
# the process can leak, and the token is what the API actually wants.
#
# Leave them empty and everything else works. `GET /api/qobuz/status` says what
# is missing, and each endpoint refuses locally with a message naming the
# setting rather than sending a request to find out.

Fonoteca__Providers__Qobuz__AppId=

# Signs `track/getFileUrl` requests, and is NOT the app id or the auth token.
#
# The one setting whose absence is invisible until somebody clicks: search and
# album browsing work fine without it, and only downloads fail — which is why
# /api/qobuz/status reports `canDownload` separately from `configured`.
#
# WHERE IT COMES FROM, AND THE TRAP.
#
# The web player bundle at play.qobuz.com/resources/<version>/bundle.js contains
# an `appSecret` in plain text, in a config object beside the app ids, under a
# key called `production`. **That is not this value.** It was tried against a
# live account and every signed request came back
# `400 Invalid Request Signature parameter (request_sig)`. The bundle holds nine
# 32-hex strings and the other seven are a Sentry DSN, an Algolia search key, two
# DASH segment UUIDs, a Gravatar hash and a cached search id — so the real
# signing secret is not in the bundle in readable form at all.
#
# It is assembled from three obfuscated pieces: an `initialSeed(...)` per
# timezone, plus a matching `info` and `extras` pair. Concatenate seed + info +
# extras, drop the last 44 characters, base64-decode. That yields one candidate
# per timezone and only one of them works — on the version measured, the third.
#
# Verify a candidate without downloading anything: sign a `track/getFileUrl` for
# any track id and look for a `url` in the response. Costs one request, and a
# wrong secret is refused in about a second.
Fonoteca__Providers__Qobuz__AppSecret=

Fonoteca__Providers__Qobuz__UserAuthToken=

# Which encoding to ask for:
#   5   MP3 320
#   6   FLAC 16-bit / 44.1kHz
#   7   FLAC up to 24-bit / 96kHz
#   27  FLAC up to 24-bit / 192kHz
#
# It costs nothing to ask high. Qobuz serve the best encoding a release actually
# has up to the one requested, so 27 against a CD master returns CD quality
# rather than an error — and the response states what came back, which is what
# gets recorded against the downloaded file.
Fonoteca__Providers__Qobuz__FormatId=27

# Milliseconds between Qobuz API requests. They publish no limit, so this is a
# bound chosen rather than discovered. Keep it conservative: the cost of being
# rate-limited here is an account, not a retry.
#
# This is the ONLY rate bound that is enforced. The reserved configuration also
# carried MaxRequestsPerHour=600, and it has been removed rather than
# implemented: RequestGate enforces a minimum interval and nothing else, and a
# name in this file that binds to nothing is the exact failure the AcoustID key
# spent months in. The arithmetic it was protecting still holds by hand — one
# album costs one search, one album lookup and one signed URL per track, so a
# twelve-track album is fourteen requests. Manual acquisition does not approach
# 600 in an hour. If that ever stops being true, the hourly ceiling has to be
# built into RequestGate, not declared here.
Fonoteca__Providers__Qobuz__MinRequestIntervalMs=1000


# ---------------------------------------------------------------------------
# Deezer                                                            [RESERVED]
# ---------------------------------------------------------------------------
# Same caveat as Qobuz: unofficial API, expect breakage.
Fonoteca__Providers__Deezer__Arl=


# ---------------------------------------------------------------------------
# Acquisition
# ---------------------------------------------------------------------------
#
# DOWNLOADS GO STRAIGHT INTO Fonoteca__LibraryPath, as
# `Artist/Album/NN Title.flac`. There is no staging directory and no import
# step.
#
# There used to be both. The reasoning was that an acquisition writing into the
# library could put a file there that the catalogue has never seen — but that
# did not survive contact with the write path. A track is written to a `.part`
# sibling, and `.part` is not an extension AudioFormats recognises, so a scan
# cannot see it; the real name only exists after the body has been checked
# against Content-Length and atomically renamed. A scan therefore only ever sees
# whole files, which is precisely what staging was there to guarantee. The
# import was a second manual act buying a property the first one already had.
#
# What staging DID buy is kept: a download into a folder that already holds
# audio the album does not list is refused rather than merged, because
# `Artist/Album` is not unique across editions and two rips in one directory is
# something no later pass can take apart.
#
# Fonoteca__Staging__Path is gone. An entry left in a .env binds to nothing.

# ---------------------------------------------------------------------------
# Replacing an album with a better copy
# ---------------------------------------------------------------------------
#
# The upgrade list on the acquire screen finds albums held in something worse
# than Qobuz sells, and pressing Upgrade on a row downloads a candidate and
# offers to retire the one it replaces.
#
# THIS IS THE ONLY OPERATION IN FONOTECA THAT TAKES A FILE AWAY FROM YOU, and it
# is deliberately NOT covered by Fonoteca__AllowFileMutation. That flag means
# "may rewrite a tag in place, having verified the write with a second library
# and journalled what was there before" — a reversible edit. This one means "may
# take an album away". Turning the first on to get your files tagged is not
# agreement to the second.
#
# Off, an upgrade still downloads and still reports whether it WOULD have
# replaced anything, so a run with it off is a complete dry run.
#
# Nothing is ever deleted. The old files are MOVED to Fonoteca__ReplacedPath
# keeping their library-relative layout, so undoing a bad upgrade is a `mv`.
# Three things are checked first, after the download and against the bytes that
# actually landed rather than against what Qobuz advertised:
#
#   - every track of the old album arrived (a licensing gap must not cost a track)
#   - what arrived measures better than the BEST file already held
#   - something has measured the old album at all — run the measure pass first
#
Fonoteca__AllowFileReplacement=false

# Where a replaced album goes. Defaults to Fonoteca__LibraryPath with
# `-replaced` appended.
#
# It must be OUTSIDE the library root, or the next scan catalogues the archive
# and the album you just replaced looks like it is still there. A sibling is the
# default because it is then on the same filesystem, which makes the move a
# rename that cannot half-finish — pointing this at another volume turns every
# replacement into a full copy of the album.
#
# Nothing prunes it. It grows until you empty it, which is the point.
#Fonoteca__ReplacedPath=/mnt/music-replaced

# Pause between tracks of one album, on top of the API's own request gate and
# for a different reason: the gate protects the JSON API, this spaces out the
# CDN transfers. Twelve hi-res tracks pulled back to back with no gap is the
# traffic shape that gets a personal subscription looked at.
Fonoteca__Download__TrackDelayMs=500


# ---------------------------------------------------------------------------
# Upgrade monitoring                                                [RESERVED]
# ---------------------------------------------------------------------------
Fonoteca__Monitor__ArtistIntervalHours=24
Fonoteca__Monitor__FullSweepHours=168


# ---------------------------------------------------------------------------
# pgAdmin — only when running `podman compose --profile tools up -d`
# ---------------------------------------------------------------------------
PGADMIN_EMAIL=dev@localhost
PGADMIN_PASSWORD=pgadmin
PGADMIN_PORT=5050
