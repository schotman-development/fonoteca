# Fonoteca — environment template
#
# Copy to `.env` and edit. `.env` is gitignored; so is every other `.env.*`
# except this file.
#
#   cp .env.example .env
#
# WHO READS THIS FILE
#
#   compose.yaml   automatically, for ${VAR} substitution
#   scripts/dev.sh exports it so the API inherits it
#
# The API is ASP.NET Core, which maps environment variables onto its
# configuration tree using a DOUBLE UNDERSCORE as the separator. So
# `Fonoteca__LibraryPath` here overrides `Fonoteca:LibraryPath` in
# appsettings.json. That is why the names below look the way they do.
#
# Anything marked RESERVED is not read by any code yet. It is here so the name
# is settled before the feature lands, not because setting it does something.
#
# QUOTE ANY VALUE CONTAINING `;`, a space, `#` or `$`.
#
# Two different parsers read this file. Compose has its own and copes with bare
# values; scripts/dev.sh sources it with `set -a` so that bash exports it, and
# bash treats `;` as a command separator. An unquoted connection string
# therefore silently loses everything after the first semicolon — including the
# password — and the failure surfaces as an authentication error from Postgres,
# a long way from the cause. Quotes satisfy both parsers.


# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Read by compose.yaml to provision the container, and by the connection string
# below. Change the password before exposing this beyond localhost.

POSTGRES_DB=fonoteca
POSTGRES_USER=fonoteca
POSTGRES_PASSWORD=fonoteca
POSTGRES_PORT=5432

# Must agree with the four values above. Kept explicit rather than assembled
# from them, because the API also has to work against a database this compose
# file did not create.
ConnectionStrings__Fonoteca="Host=localhost;Port=5432;Database=fonoteca;Username=fonoteca;Password=fonoteca"


# ---------------------------------------------------------------------------
# Library
# ---------------------------------------------------------------------------

# Absolute path to the music library root, as the API process sees it.
Fonoteca__LibraryPath=/mnt/music

# Whether the app may MODIFY files in the library.
#
# Leave this false. No code path writes to an audio file yet, and it should stay
# that way until the verified write path in Fonoteca.Tagging exists — read with
# two libraries, stage, read back with both, atomic swap, undo journal. See
# docs/adr/0002-two-tag-libraries.md.
#
# When you do enable it, take a backup first.
Fonoteca__AllowFileMutation=false

# How many files to hash and fingerprint at once. Each one spawns an ffprobe or
# fpcalc process, so this is roughly a process-count budget; past core count it
# buys nothing and starves the API.
Fonoteca__ScanConcurrency=4


# ---------------------------------------------------------------------------
# External binaries
# ---------------------------------------------------------------------------
# Bare names resolve through PATH, which works when env.sh has been sourced.
# Set absolute paths for a long-running service: a process started from a
# desktop session that predates the toolchain keeps the PATH it was born with,
# and will not find these however correct `which` looks at your prompt.

Fonoteca__FfmpegPath=ffmpeg
Fonoteca__FfprobePath=ffprobe
Fonoteca__FpcalcPath=fpcalc


# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Origins allowed to call the API. Same-origin in production; in development the
# Vite dev server and Storybook are separate origins and must be listed.
Fonoteca__CorsOrigins__0=http://localhost:5173
Fonoteca__CorsOrigins__1=http://localhost:6006


# ---------------------------------------------------------------------------
# MusicBrainz
# ---------------------------------------------------------------------------

# REQUIRED before any MusicBrainz call. They enforce roughly one request per
# second and require a User-Agent that identifies the application and gives them
# a way to contact you. Sending a generic agent gets the IP blocked, so this is
# configuration rather than a constant.
#
#   Fonoteca/0.1 ( you@example.com )
Fonoteca__MusicBrainzContact=


# ---------------------------------------------------------------------------
# AcoustID                                                          [RESERVED]
# ---------------------------------------------------------------------------
# Free application key from https://acoustid.org/new-application
Fonoteca__Providers__AcoustId__ApiKey=


# ---------------------------------------------------------------------------
# Qobuz                                                             [RESERVED]
# ---------------------------------------------------------------------------
# Your own subscription. Reverse-engineered API with no published contract — it
# will change without warning, which is why it sits behind a narrow interface.
#
# The two limits below are carried over from the previous configuration, where
# they clearly existed for a reason. Keep them conservative: the cost of being
# rate-limited is an account, not a retry.

Fonoteca__Providers__Qobuz__AppId=
Fonoteca__Providers__Qobuz__UserAuthToken=
Fonoteca__Providers__Qobuz__MaxRequestsPerHour=600
Fonoteca__Providers__Qobuz__MinRequestIntervalMs=1000


# ---------------------------------------------------------------------------
# Deezer                                                            [RESERVED]
# ---------------------------------------------------------------------------
# Same caveat as Qobuz: unofficial API, expect breakage.
Fonoteca__Providers__Deezer__Arl=


# ---------------------------------------------------------------------------
# Acquisition                                                       [RESERVED]
# ---------------------------------------------------------------------------

# Where downloads land before they are verified and moved into the library.
# Must be on the SAME FILESYSTEM as the library, otherwise the final move stops
# being atomic and a crash mid-import can leave a half-written file in place.
Fonoteca__Staging__Path=/mnt/music/.fonoteca-staging

Fonoteca__Download__Concurrency=2
Fonoteca__Download__TrackDelayMs=500


# ---------------------------------------------------------------------------
# Upgrade monitoring                                                [RESERVED]
# ---------------------------------------------------------------------------
Fonoteca__Monitor__ArtistIntervalHours=24
Fonoteca__Monitor__FullSweepHours=168


# ---------------------------------------------------------------------------
# pgAdmin — only when running `podman compose --profile tools up -d`
# ---------------------------------------------------------------------------
PGADMIN_EMAIL=dev@localhost
PGADMIN_PASSWORD=pgadmin
PGADMIN_PORT=5050
