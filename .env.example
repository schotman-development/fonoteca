# =============================================================================
# Qobuzarr configuration
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in the credentials. Every key below is optional
# EXCEPT QOBUZ_APP_ID and QOBUZ_USER_AUTH_TOKEN. Values shown are the defaults
# baked into app/config.py, so you only need to uncomment what you change.
#
# Booleans accept: true/false, 1/0, yes/no, on/off.
#
# -----------------------------------------------------------------------------
# SEVEN OF THESE KEYS CAN ALSO BE CHANGED FROM THE SETTINGS SCREEN, AND WHEN
# THEY ARE, THE DATABASE WINS OVER THIS FILE.
#
#   NAMING_TEMPLATE  ENRICHMENT_SOURCES  UPGRADE_CLEANUP  LIBRARY_SCAN_NIGHTLY
#   INTEGRITY_ENABLED  ENRICHMENT_WRITE_BACK  NFO_ENABLED
#
# Each is marked `[OVERRIDABLE]` where it appears below. Pressing a switch on
# the Settings screen writes a row to the `app_setting` table, and that row is
# read in preference to the line here -- you changed the switch more recently
# than you edited this file, so that is the newer instruction. Editing a value
# here while an override is stored for it changes NOTHING that is visible; the
# screen reports the origin of each of the seven as `.env` or `override`, and
# "Reset to .env" deletes the row and hands the key back to this file.
#
# Everything else in this file is environment-only and takes a restart. That
# boundary is deliberate rather than incidental: no credential, no path and no
# rate-limit figure is writable through the API, and asking to change one is an
# error rather than a silent no-op. The `cli.py` commands read the overlay too,
# so `enrich-now` runs the ladder you arranged on the screen.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Qobuz credentials (REQUIRED)
# -----------------------------------------------------------------------------
# The app id used by the Qobuz web player and the auth token for YOUR paid
# account. The token is a long opaque string obtained from a logged-in session.
QOBUZ_APP_ID=123456789
QOBUZ_USER_AUTH_TOKEN=your_user_auth_token_here

# Optional. The app secret used to sign `track/getFileUrl` requests.
# If omitted, Qobuzarr derives it from the public web-player bundle on first
# use, validates it against the live API, and caches the winner to
# data/secret.cache. Setting it here skips that work entirely (recommended
# once you know it, it is printed to the log when derived).
#QOBUZ_APP_SECRET=

# API base + browser User-Agent sent on every outbound request.
#QOBUZ_API_BASE=https://www.qobuz.com/api.json/0.2/
#QOBUZ_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Mirror follows/unfollows to your Qobuz account favourites (favorite/create).
#QOBUZ_FAVORITE_SYNC=false

# Per-request network timeouts (seconds).
#QOBUZ_REQUEST_TIMEOUT=30.0
#DOWNLOAD_TIMEOUT=300.0


# =============================================================================
# 2. RATE LIMITING  --  the headline requirement: BE SLOW AND POLITE
# -----------------------------------------------------------------------------
# A single global limiter gates EVERY outbound Qobuz call (indexer, UI search,
# downloads alike). Pick one of the three profiles below.
#
#   QOBUZ_MIN_REQUEST_INTERVAL  minimum seconds between ANY two API calls
#   QOBUZ_MAX_REQUESTS_PER_HOUR rolling 1-hour ceiling on API calls
#   INDEXER_ARTIST_INTERVAL     seconds between checking one artist and the next
#   INDEXER_FULL_SWEEP_HOURS    target period to cover every monitored artist
#   DOWNLOAD_TRACK_DELAY        seconds between consecutive track downloads
#   DOWNLOAD_CONCURRENCY        parallel downloads -- keep this at 1
# =============================================================================

# --- Profile: MODERATE (default, currently active) ---------------------------
QOBUZ_MIN_REQUEST_INTERVAL=2.0
QOBUZ_MAX_REQUESTS_PER_HOUR=1200
INDEXER_ARTIST_INTERVAL=300
INDEXER_FULL_SWEEP_HOURS=6
DOWNLOAD_TRACK_DELAY=3.0
DOWNLOAD_CONCURRENCY=1

# --- Profile: VERY SLOW ------------------------------------------------------
#QOBUZ_MIN_REQUEST_INTERVAL=6.0
#QOBUZ_MAX_REQUESTS_PER_HOUR=400
#INDEXER_ARTIST_INTERVAL=900
#INDEXER_FULL_SWEEP_HOURS=24
#DOWNLOAD_TRACK_DELAY=8.0
#DOWNLOAD_CONCURRENCY=1

# --- Profile: GLACIAL --------------------------------------------------------
#QOBUZ_MIN_REQUEST_INTERVAL=20.0
#QOBUZ_MAX_REQUESTS_PER_HOUR=150
#INDEXER_ARTIST_INTERVAL=3600
#INDEXER_FULL_SWEEP_HOURS=72
#DOWNLOAD_TRACK_DELAY=20.0
#DOWNLOAD_CONCURRENCY=1


# -----------------------------------------------------------------------------
# 3. Backoff / circuit breaker
# -----------------------------------------------------------------------------
# Fractional jitter applied to the indexer interval so the pattern is never
# perfectly periodic (0.25 => +/- 25%).
#INDEXER_JITTER_PCT=0.25

# Exponential backoff for HTTP 429 / 5xx. `Retry-After` always wins when sent.
#BACKOFF_INITIAL=5.0
#BACKOFF_MAX=600.0
#BACKOFF_MULTIPLIER=2.0
#BACKOFF_JITTER=0.3
#REQUEST_MAX_RETRIES=5

# After this many 429s inside the observation window, the breaker trips and the
# indexer is paused for the cooldown period.
#CIRCUIT_BREAKER_THRESHOLD=3
#CIRCUIT_BREAKER_WINDOW=300
#CIRCUIT_BREAKER_COOLDOWN=1800

# Indexer master switch and page size used when listing an artist's releases.
#INDEXER_ENABLED=true
#INDEXER_PAGE_SIZE=50
#INDEXER_MAX_PAGES=20

# Import an artist's back catalogue immediately when you follow them. This is
# read-only and rate-limited (it downloads nothing), but it is many API calls.
# When false, the artist just waits for the next scheduled indexer tick.
#AUTO_INDEX_ON_FOLLOW=true


# -----------------------------------------------------------------------------
# 4. Downloads
# -----------------------------------------------------------------------------
# ** Automatic downloading is OPT-IN and off by default. **
# With AUTO_DOWNLOAD=false the indexer still discovers releases and marks them
# `wanted`, but nothing is ever queued until you say so — via the per-album
# "Download" button, "Download wanted" on an artist page, or the JSON API
# (POST /api/albums/{id}/queue, POST /api/artists/{id}/download-wanted).
# Set this to true for hands-off, Lidarr-style behaviour: every new release by a
# monitored artist starts downloading on its own.
#AUTO_DOWNLOAD=false

# Attempts before a queue item is marked failed, and the pause between them.
#DOWNLOAD_MAX_ATTEMPTS=3
#DOWNLOAD_RETRY_DELAY=60.0
# Streaming chunk size in bytes.
#DOWNLOAD_CHUNK_SIZE=1048576
# Write cover.jpg into each album folder.
#DOWNLOAD_EMBED_COVER=true
#DOWNLOAD_WRITE_COVER_FILE=true


# -----------------------------------------------------------------------------
# 5. Paths
# -----------------------------------------------------------------------------
# Where finished music lands. A relative path is resolved against the repo root,
# so the defaults below work unchanged; point LIBRARY_PATH at your real music
# collection if it lives elsewhere.
LIBRARY_PATH=music
# Database, logs, secret cache, partial downloads.
DATA_PATH=data

# --- Disk scan ---------------------------------------------------------------
# The disk scan (Disk scan page, `cli.py scan-library`, POST /api/library/scan)
# walks LIBRARY_PATH, reads the tags off every audio file and marks albums it
# recognises as downloaded, so Qobuzarr stops wanting music you already own.
# It makes no Qobuz API call and never renames, moves or modifies a file.
#
# Run it as part of the nightly housekeeping job. Safe to leave on: a scan can
# only ever mark albums *present*, never wanted, so it cannot cause a download.
# [OVERRIDABLE] also a switch on the Settings screen; the database wins.
#LIBRARY_SCAN_NIGHTLY=true
#
# Also FOLLOW the artists the nightly scan found on disk but nobody follows yet.
# This is the one nightly step that adds work instead of reducing it, which is
# why it is off by default and why it is worth understanding before turning on:
#   - it spends one Qobuz search per unfollowed artist (7 minutes for 136),
#     through the same limiter and circuit breaker as everything else;
#   - it follows only on an exact name match, or — for the folders a name cannot
#     settle — an exact barcode match through AcoustID -> MusicBrainz -> Qobuz;
#   - it downloads NOTHING. AUTO_DOWNLOAD still decides that, and the new
#     artists are indexed one per scheduled tick rather than all at once.
# What it does change is the size of your wanted list, which is the real cost:
# following a prolific artist can add hundreds of wanted releases overnight.
#LIBRARY_FOLLOW_NIGHTLY=false
#
# Fraction of an album's Qobuz track count that must be on disk before the album
# counts as complete. 1.0 = every track. Lowering it adopts albums whose edition
# differs from the Qobuz one, at the risk of calling a half-present album done.
# Clamped to (0, 1].
#LIBRARY_SCAN_COMPLETE_RATIO=1.0
#
# Descend into symlinked directories while walking. Off by default: a link that
# points at one of its own ancestors would loop forever.
#LIBRARY_SCAN_FOLLOW_SYMLINKS=false

# --- File integrity ----------------------------------------------------------
# Everything Qobuzarr knows about a track -- which recording it is, which release
# it belongs to, whether the audio decodes -- is a claim about a *file*. A tag
# editor, a re-rip, a media server with write access or a copy that stopped
# halfway all leave the database describing a file that no longer exists in that
# form, and without this nothing ever notices.
#
# So each file carries a recorded hash, and it is checked before that claim is
# believed. Three states, not two: a file nothing has ever baselined is
# "unknown", which is not the same as "changed" -- otherwise a library switching
# this on would report every file it owns as tampered with on day one.
# [OVERRIDABLE] also a switch on the Settings screen; the database wins.
#INTEGRITY_ENABLED=true
#
# How much of the library is re-hashed on each nightly run, whether or not it
# looks changed.
#
# The routine check is a stat -- size and mtime -- because hashing a whole file
# costs about 200 ms and a 30 000-file library is an hour and a half of disk. But
# size and mtime are a tripwire, not evidence: a tool that rewrites a file and
# then restores its mtime walks straight past them, and so does a filesystem with
# one-second timestamps. Re-hashing a slice of the library anyway bounds how long
# such a file can stay hidden, at a cost you choose in advance.
#
# 1/30 verifies everything once a month. Clamped to (0, 1]; raise it to sweep
# faster, and use INTEGRITY_ENABLED=false rather than 0 to stop entirely.
#INTEGRITY_REVERIFY_FRACTION=0.0333

# --- Trash -------------------------------------------------------------------
# Qobuzarr never unlinks anything from LIBRARY_PATH. Deleting a release, and
# clearing away a copy an upgrade has replaced, moves the files here instead;
# they stay until you empty the trash from the Library tidy page (or
# DELETE /api/library/trash). Defaults to DATA_PATH/trash.
#
# Put this on the same filesystem as LIBRARY_PATH if you can — then a delete is
# an instant rename rather than a copy of the whole album.
#TRASH_PATH=data/trash
#
# Whether a *completed* upgrade may move the copy it superseded to the trash by
# itself. You already confirmed the upgrade, so the cleanup is not a surprise;
# an upgrade that finished with a failed or unstreamable track never cleans up,
# because the old copy is then the better one. Turn this off to keep both
# copies and decide by hand.
# [OVERRIDABLE] also a switch on the Settings screen; the database wins.
#UPGRADE_CLEANUP=true


# -----------------------------------------------------------------------------
# 6. Quality
# -----------------------------------------------------------------------------
# format_id reference:
#    5 = MP3 320 kbps
#    6 = FLAC 16bit / 44.1 kHz
#    7 = FLAC 24bit / <= 96 kHz
#   27 = FLAC 24bit / <= 192 kHz (hi-res)
# Asking for more than your account is entitled to silently downgrades; the
# format actually returned by the API is what gets tagged and named.
#DEFAULT_FORMAT_ID=27


# -----------------------------------------------------------------------------
# 7. Library organisation
# -----------------------------------------------------------------------------
# Path template, relative to LIBRARY_PATH. Anything wrapped in [ ... ] is an
# optional segment that is dropped entirely when the placeholder inside it is
# empty. `{disc_prefix}` expands to "Disc N/" only when media_count > 1.
# Available placeholders: {artist} {albumartist} {album} {version} {year}
# {quality} {disc_prefix} {disc} {track} {title} {ext} {label} {genre}
# [OVERRIDABLE] also editable on the Settings screen; the database wins. A
# template two tracks of one release would collapse onto one path is refused
# there rather than discovered during a re-file.
#NAMING_TEMPLATE={artist}/{album} ({year})[ [{quality}]]/{disc_prefix}{track:02d} - {title}.{ext}

# Max characters for any single path component after sanitising.
#MAX_PATH_COMPONENT_LENGTH=180
# Replacement for characters that are illegal in a POSIX path component.
#PATH_REPLACEMENT_CHAR=_


# -----------------------------------------------------------------------------
# 8. Defaults applied to newly added artists
# -----------------------------------------------------------------------------
# all | future | none
#DEFAULT_MONITOR_MODE=all
# Free-form label resolved to a format_id by the downloader.
#DEFAULT_QUALITY_PROFILE=default
# Comma-separated subset of: album,ep,single,live,compilation,download,other
#DEFAULT_ACCEPTED_RELEASE_TYPES=album,ep


# -----------------------------------------------------------------------------
# 9. Web server
# -----------------------------------------------------------------------------
# One process serves everything: the JSON API under /api, the liveness probe at
# /health, and the React interface for every other path.
#HOST=127.0.0.1
#PORT=8000
#RELOAD=false
#
# There is deliberately NO setting for the web interface. It is built from web/
# into static/app by `npm run build --prefix web`, and the server reads that
# directory directly -- it checks for the build on each request, so one that
# lands while the server is running is picked up without a restart. A checkout
# that has never been built has no UI; every page then answers with a short
# document naming that command, and the API keeps working meanwhile. Making the
# location configurable would only add a way to point at a build that is not
# there.
#
# RELOAD is uvicorn's Python auto-reload and has nothing to do with the front
# end. For front-end work run `npm run dev --prefix web` alongside the server:
# Vite proxies /api, /health and /static back to it, so the dev server talks to
# this same database and these same credentials.


# -----------------------------------------------------------------------------
# 10. Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
#LOG_LEVEL=INFO
#LOG_FILE_NAME=qobuzarr.log
#LOG_MAX_BYTES=5242880
#LOG_BACKUP_COUNT=5
# Keep this on. It masks the auth token, app secret and signed file URLs.
#LOG_REDACT_SECRETS=true


# -----------------------------------------------------------------------------
# 11. Metadata enrichment (open sources)
# -----------------------------------------------------------------------------
# Qobuz knows what it sells. Everything else a music library wants to know —
# who an artist is, what a release actually is, what identifiers other tools
# expect to find in the files — comes from open catalogues.
#
# What leaves this machine when enrichment is on: artist names, release
# barcodes, and (if you enable fingerprinting) an acoustic hash of files
# already on disk. Never the files themselves, and nothing about the Qobuz
# account. All of it is read-only -- enrichment never downloads audio and never
# queues anything -- with one exception, ACOUSTID_SUBMIT below, which is off.
#
# Scope is fixed and has no setting: only albums that are on disk (status
# "downloaded", including the ones the disk scan adopted) and the artists who
# own at least one of them are ever enriched. Wanted and ignored releases are
# not — there are no files to tag and no NFO to write. Rows left over from a
# wider scope are deleted by nightly housekeeping, or by "cli.py enrich-purge".
#
# Set to false and no request to a third party is ever made.
#ENRICHMENT_ENABLED=true

# The ladder, in the order it runs. Drop any of them.
#
# AcoustID is first because the audio is the anchor. Every other input to an
# identification is something somebody typed -- a folder name, a tag written by
# another program, a barcode hand-entered into a catalogue -- and a library that
# needs identifying is precisely one where some of that typing is wrong. The
# waveform is the one thing in it that cannot be mistagged, so the ladder starts
# there and the rungs below corroborate what the audio already said.
#
# MusicBrainz now runs BEFORE Deezer, which is a reversal. The old order said
# MusicBrainz can only be matched exactly, exact matching needs a barcode, and
# Deezer is where most barcodes come from. AcoustID changed that premise: it
# writes a MusicBrainz release id straight onto the album, which is a stronger
# key than a barcode and one MusicBrainz owns. On a 422-release library
# MusicBrainz resolved 253 releases off the audio's answer while Deezer, running
# first, said "no barcode on this release" about 197 of the same albums.
#
# For a release the audio could not pin, Deezer-first is still better, and one
# order cannot serve both. What settles it is not the order: a rung that refused
# for want of a barcode is re-opened as soon as any later rung learns one, so the
# ladder reaches the same answer either way and the order only decides how many
# ticks it takes. Run `cli.py backfill-upc` to fetch the barcodes Qobuz holds for
# releases already on disk -- the endpoint the indexer builds album rows from
# does not publish one, so almost none of an adopted library has a barcode at all.
# [OVERRIDABLE] also re-orderable on the Settings screen; the database wins.
# The one override that may not take effect on the spot: the ladder owns a rate
# limiter per source, and there must never be two ladders alive, so a rebuild
# that cannot happen while a tick is running waits for the next one -- and the
# screen says so rather than pretending.
#ENRICHMENT_SOURCES=acoustid,musicbrainz,deezer,coverartarchive,wikidata

# An email address or URL identifying this installation.
#
# MusicBrainz policy requires a User-Agent naming the application and a contact,
# and it blocks generic browser strings. Until this is set the MusicBrainz rung
# reports itself "gated" and is skipped — everything else keeps working. It is
# deliberately not defaulted: putting a stranger's address in someone else's
# request logs is not ours to do.
#ENRICHMENT_CONTACT=you@example.com

# Free application key from https://acoustid.org/new-application.
# The only source here that needs registering. Without it, audio fingerprinting
# is skipped: no match confirmation, no duplicate detection, no corrupt-file
# check.
#ACOUSTID_API_KEY=

# Whether fingerprints that matched nothing are contributed back to AcoustID.
#
# OFF, and deliberately so. Everything else enrichment does is a read that leaves
# no trace upstream; this is a WRITE to a public database, made under your own
# API key, and you cannot take it back. If Qobuzarr got a release wrong, turning
# this on publishes that mistake for everyone else to inherit. Turn it on only if
# you mean to contribute -- and it does nothing without ACOUSTID_API_KEY, since a
# submission has to be made under some account.
#ACOUSTID_SUBMIT=false

# Chromaprint's fpcalc binary. Empty means "look on PATH", which is enough when
# you start Qobuzarr from a shell. Set it explicitly for anything long-lived: a
# process keeps the PATH it was born with, so installing fpcalc afterwards leaves
# a running server still reporting the rung as unavailable.
#FPCALC_PATH=/home/you/.local/opt/chromaprint/fpcalc

# How much of the evidence must agree before a value Qobuz supplied is
# overwritten. Qobuz counts as one source, so with a single rung enabled a
# disagreement is 1-1 — a tie, and a tie changes nothing.
#
# Values at or below 0.5 are clamped up: with four sources, two outvoting the
# other two is a coin flip.
#ENRICHMENT_CONSENSUS_THRESHOLD=0.51

# There is no setting for how much of a folder a candidate release must explain,
# and that is on purpose. Identification solves the album, never the track: a
# release is admissible only when every file maps to a distinct position in it,
# its track count agrees, and it accounts for essentially all the files. The
# measured gap it has to separate is a release explaining 15 files of 15 from one
# explaining 1 of 15 -- nowhere near any boundary. Exposing the number would
# invite turning it down until something matched, which is how a requirement
# becomes a score, and a score is what "exact or nothing" refuses to be.

# Whether a majority may rewrite an album's release type. This is the *only*
# Qobuz-owned column enrichment ever touches, because Qobuz genuinely guesses
# it — anything under four tracks becomes a "single".
#
# It changes the type and never the status, so it can neither create a wanted
# release nor cancel one. The original value is kept, so it is reversible.
#ENRICHMENT_APPLY_RELEASE_TYPE=true

# Pacing. Unlike the indexer, this is not throttled to protect a paid account —
# these are public APIs with published allowances — so what matters is the
# per-source interval below, not the tick rate.
#ENRICHMENT_INTERVAL=300
#ENRICHMENT_BATCH_SIZE=25
# Wall-clock seconds one tick may spend before leaving the rest for the next.
#ENRICHMENT_TICK_BUDGET=240
# How long a successful match stays fresh.
#ENRICHMENT_REFRESH_DAYS=90
# Consecutive all-failed ticks before the job pauses itself. Stops an offline
# machine writing one activity row per album.
#ENRICHMENT_FAILURE_CUTOFF=5

# Whether the cover shown in the UI prefers external artwork over Qobuz's. Off
# by default: Qobuz's image matches the exact release it sells, so the others
# are better used to fill the gaps. Behind Qobuz the order is Deezer, then the
# Cover Art Archive -- Deezer serves the label's own 1000x1000 art, the Archive
# whatever a contributor happened to upload.
#ENRICHMENT_PREFER_EXTERNAL_COVER=false

# Whether identifying a release also writes the ids into the files on disk. On
# by default: enrichment is scoped to the library, so it always arrives after
# the download loop has finished tagging, and ids that stay in the database are
# ids no music player will ever read. Only releases Qobuzarr downloaded itself
# are re-tagged -- an album adopted from disk keeps the tags it arrived with and
# gets its NFO only, which is merged rather than replaced.
# [OVERRIDABLE] also a switch on the Settings screen; the database wins.
#ENRICHMENT_WRITE_BACK=true

# Per-source pacing. Deezer publishes ~50 requests per 5 seconds; MusicBrainz
# asks for roughly one per second and enforces it with HTTP 503.
#DEEZER_MIN_REQUEST_INTERVAL=0.25
#DEEZER_MAX_REQUESTS_PER_HOUR=5000
#MUSICBRAINZ_MIN_REQUEST_INTERVAL=1.1
#MUSICBRAINZ_MAX_REQUESTS_PER_HOUR=3000
#ACOUSTID_MIN_REQUEST_INTERVAL=0.34
#ACOUSTID_MAX_REQUESTS_PER_HOUR=3000
#COVERART_MIN_REQUEST_INTERVAL=0.5
#COVERART_MAX_REQUESTS_PER_HOUR=3000
#WIKIDATA_MIN_REQUEST_INTERVAL=0.5
#WIKIDATA_MAX_REQUESTS_PER_HOUR=3000

# Licensing, since enrichment puts other people's data in your library:
# MusicBrainz is CC0, Cover Art Archive images carry per-item licences from
# whoever uploaded them, and Wikipedia text is CC BY-SA — which is why a
# biography is always stored and displayed with its source link.


# -----------------------------------------------------------------------------
# 12. NFO files
# -----------------------------------------------------------------------------
# Kodi/Jellyfin-style artist.nfo and album.nfo written next to the music, from
# whatever enrichment resolved.
#
# An existing file is MERGED INTO, never replaced. If Jellyfin, Emby or Kodi
# already manages this library it has written these files, and they hold a
# biography, artwork paths and that server's own ids — none of which Qobuzarr
# knows. Only the elements Qobuzarr generated are updated; everything else stays
# where it is, in the spelling the file already uses.
#
# A file containing <lockdata>true</lockdata> is not touched at all: that is how
# you tell your media server to stop editing it, and this respects it too.
#
# Off means no .nfo is ever created or touched.
# [OVERRIDABLE] also a switch on the Settings screen; the database wins.
#NFO_ENABLED=true
