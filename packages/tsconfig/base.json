{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Fonoteca base",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    // Relative imports carry an explicit `.ts` extension and are rewritten to
    // `.js` on emit. This is what lets `node src/build.ts` run a source file
    // directly under Node 24's native type stripping, with no build step and no
    // separate runner dependency, while still emitting valid JS for consumers.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
