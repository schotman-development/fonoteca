{
  "name": "@fonoteca/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design tokens: one TypeScript source, emitted as CSS custom properties and typed var() references.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node src/build.ts && tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "node --test src/*.test.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@fonoteca/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "typescript": "7.0.2"
  }
}
