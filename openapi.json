{
  "openapi": "3.1.1",
  "info": {
    "title": "Fonoteca.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/system/info": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Runtime configuration and catalogue counts.",
        "operationId": "GetSystemInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/musicbrainz": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Which MusicBrainz server is in use, and whether it is answering.",
        "operationId": "GetMusicBrainzHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MusicBrainzHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/scan": {
      "post": {
        "tags": [
          "Library"
        ],
        "summary": "Reconcile the catalogue's file list with the files on disk.",
        "description": "Walks the library root, adding files that are new, updating those whose size or modification time changed, and removing rows for files that are gone. Reads no file contents and modifies no file.",
        "operationId": "ScanLibrary",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryScanSummary"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Library"
        ],
        "summary": "Whether a scan is running, and what the last one found.",
        "operationId": "GetLibraryScanStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryScanStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/identify": {
      "post": {
        "tags": [
          "Library"
        ],
        "summary": "Fingerprint the files with no AcoustID and look them up.",
        "description": "Returns immediately with a job id; progress arrives on the jobs hub. This pass opens every file that has not been identified, runs fpcalc on it and asks AcoustID, which enforces three requests a second — so a first pass over a large library is a matter of tens of minutes, not seconds. Tags are only written when Fonoteca:AllowFileMutation is enabled; with it off the pass still fingerprints and identifies everything, so enabling it and running again costs no further lookups.",
        "operationId": "StartLibraryIdentification",
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentificationStartedResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Library"
        ],
        "summary": "How many files still have no AcoustID, and how the last pass went.",
        "operationId": "GetLibraryIdentificationStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentificationStatusResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Library"
        ],
        "summary": "Ask the running pass to stop after the file it is on.",
        "operationId": "CancelLibraryIdentification",
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogueCounts": {
        "required": [
          "files",
          "recordings",
          "releases",
          "artists"
        ],
        "type": "object",
        "properties": {
          "files": {
            "type": "integer",
            "format": "int32"
          },
          "recordings": {
            "type": "integer",
            "format": "int32"
          },
          "releases": {
            "type": "integer",
            "format": "int32"
          },
          "artists": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "IdentificationStartedResponse": {
        "required": [
          "jobId",
          "pending"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "pending": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "IdentificationStatusResponse": {
        "required": [
          "running",
          "jobId",
          "processed",
          "total",
          "currentFile",
          "pending",
          "writesTags",
          "lastCompleted"
        ],
        "type": "object",
        "properties": {
          "running": {
            "type": "boolean"
          },
          "jobId": {
            "type": [
              "null",
              "string"
            ]
          },
          "processed": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "currentFile": {
            "type": [
              "null",
              "string"
            ]
          },
          "pending": {
            "type": "integer",
            "format": "int32"
          },
          "writesTags": {
            "type": "boolean"
          },
          "lastCompleted": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IdentificationSummary"
              }
            ]
          }
        }
      },
      "IdentificationSummary": {
        "required": [
          "jobId",
          "startedAtUtc",
          "completedAtUtc",
          "durationMilliseconds",
          "examined",
          "alreadyTagged",
          "fingerprinted",
          "identified",
          "unknown",
          "ambiguous",
          "belowThreshold",
          "unfingerprintable",
          "tagged",
          "writeRefused",
          "tagUnreadable",
          "failed",
          "cancelled"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "startedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "completedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "durationMilliseconds": {
            "type": "integer",
            "format": "int64"
          },
          "examined": {
            "type": "integer",
            "format": "int32"
          },
          "alreadyTagged": {
            "type": "integer",
            "format": "int32"
          },
          "fingerprinted": {
            "type": "integer",
            "format": "int32"
          },
          "identified": {
            "type": "integer",
            "format": "int32"
          },
          "unknown": {
            "type": "integer",
            "format": "int32"
          },
          "ambiguous": {
            "type": "integer",
            "format": "int32"
          },
          "belowThreshold": {
            "type": "integer",
            "format": "int32"
          },
          "unfingerprintable": {
            "type": "integer",
            "format": "int32"
          },
          "tagged": {
            "type": "integer",
            "format": "int32"
          },
          "writeRefused": {
            "type": "integer",
            "format": "int32"
          },
          "tagUnreadable": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          },
          "cancelled": {
            "type": "boolean"
          }
        }
      },
      "LibraryScanStatusResponse": {
        "required": [
          "running",
          "lastCompleted"
        ],
        "type": "object",
        "properties": {
          "running": {
            "type": "boolean"
          },
          "lastCompleted": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LibraryScanSummary"
              }
            ]
          }
        }
      },
      "LibraryScanSummary": {
        "required": [
          "startedAtUtc",
          "completedAtUtc",
          "durationMilliseconds",
          "filesSeen",
          "added",
          "updated",
          "unchanged",
          "removed",
          "unreadableDirectories"
        ],
        "type": "object",
        "properties": {
          "startedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "completedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "durationMilliseconds": {
            "type": "integer",
            "format": "int64"
          },
          "filesSeen": {
            "type": "integer",
            "format": "int32"
          },
          "added": {
            "type": "integer",
            "format": "int32"
          },
          "updated": {
            "type": "integer",
            "format": "int32"
          },
          "unchanged": {
            "type": "integer",
            "format": "int32"
          },
          "removed": {
            "type": "integer",
            "format": "int32"
          },
          "unreadableDirectories": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MusicBrainzHealthResponse": {
        "required": [
          "server",
          "isOfficialServer",
          "minimumRequestIntervalMs",
          "contactConfigured",
          "status",
          "latencyMs",
          "detail",
          "checkedAtUtc"
        ],
        "type": "object",
        "properties": {
          "server": {
            "type": "string"
          },
          "isOfficialServer": {
            "type": "boolean"
          },
          "minimumRequestIntervalMs": {
            "type": "integer",
            "format": "int32"
          },
          "contactConfigured": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/MusicBrainzReachability"
          },
          "latencyMs": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "checkedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MusicBrainzReachability": {
        "enum": [
          "NotConfigured",
          "Reachable",
          "Unreachable",
          "Rejected"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SystemInfoResponse": {
        "required": [
          "version",
          "serverTimeUtc",
          "libraryPath",
          "fileMutationAllowed",
          "counts"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "serverTimeUtc": {
            "type": "string",
            "format": "date-time"
          },
          "libraryPath": {
            "type": "string"
          },
          "fileMutationAllowed": {
            "type": "boolean"
          },
          "counts": {
            "$ref": "#/components/schemas/CatalogueCounts"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Library"
    }
  ]
}