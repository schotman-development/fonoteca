# Virtualenv
.venv/
venv/
env/

# Secrets / local config
.env
.env.bak-*
data/secret.cache

# Application state (SQLite db, logs, caches, covers)
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# Downloaded music library
music/
library/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Front-end: dependencies and build output.
# static/app is generated by `npm run build --prefix web`; it is not committed,
# so a checkout needs Node once to produce a servable UI. See README.
web/node_modules/
web/.vite/
web/coverage/
static/app/
# vitest writes its cache relative to the repo root, not to web/
node_modules/
.vite/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
